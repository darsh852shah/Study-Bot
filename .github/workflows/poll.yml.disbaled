name: Poll Telegram Logs

on:
  schedule:
    - cron: '*/15 4-16 * * *'  # every 15 min, ~9:30 AM - 9:30 PM IST
  workflow_dispatch:

permissions:
  contents: write


jobs:
  poll:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: pip install -r requirements.txt
      - run: python poll_log.py
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          NOTION_API_KEY: ${{ secrets.NOTION_API_KEY }}
          NOTION_DATABASE_ID: ${{ secrets.NOTION_DATABASE_ID }}
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
      - name: Commit updated offset and pending draft
        run: |
          git config user.name "study-bot"
          git config user.email "actions@github.com"
          git add last_update_id.txt pending_log.json
          git diff --staged --quiet || git commit -m "update offset / pending draft"
          git push
